{
  "name": "crowd-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 3 crowd rendering proof of concept. Thin-instanced, GPU vertex-texture-skinned troops with three LOD tiers.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:assets": "node tools/build-assets.mjs",
    "check:manifest": "node tools/manifest-check.mjs",
    "build": "npm run typecheck && npm run check:manifest && npm run bundle",
    "bundle": "node tools/bundle.mjs",
    "bench": "node tools/benchmark.mjs",
    "bench:lod": "node tools/benchmark.mjs --lod-sweep",
    "bench:cpu": "node tools/benchmark.mjs --cpu-baseline",
    "serve": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:manifest && npm run bench"
  },
  "dependencies": {
    "@babylonjs/core": "8.29.1",
    "@babylonjs/loaders": "8.29.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.25.0",
    "playwright": "1.63.0",
    "typescript": "5.7.2"
  }
}
