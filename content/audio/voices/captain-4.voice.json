  "loudness_lufs": -23.3,
  "lines": [
    {
      "index": 0,
      "text": "Right flank, take the open ground, do not wait for me.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 1,
      "text": "Stop where you are and let them come to us.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 2,
      "text": "Rounds on that gun, ignore the trucks for one minute.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 3,
      "text": "Reserve stays back until I say, that is what a reserve is for.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 4,
      "text": "Supply, we need ammunition in the next ten minutes or we lose this.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 5,
      "text": "Scouts, find me a way around them and do not announce yourself.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 6,
      "text": "Water first, then food, in that order, and do not argue.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 7,
      "text": "Everybody back twenty yards, I am doing the same thing.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 8,
      "text": "We are outnumbered and that changes nothing until somebody panics.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    },
    {
      "index": 9,
      "text": "I need a body in that ditch and I need one now.",
      "emotion": "stern",
      "context_tags": [
        "combat",
        "order"
      ]
    }
  ]
}
