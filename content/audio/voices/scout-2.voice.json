  "lines": [
    {
      "index": 0,
      "text": "Truck column, maybe eight vehicles, still out of range.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 1,
      "text": "I marked the enemy position. Do not ask me to explain it, just look.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 2,
      "text": "Dirt road comes out at their rear. Rear, where they are not looking.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 3,
      "text": "I have got eyes on the pass. Nothing moving and that worries me.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 4,
      "text": "Field of fire is open all the way to that tree line. Nowhere to hide.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 5,
      "text": "Came up on a supply wagon. No guard on it, that is a mistake or a trap.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 6,
      "text": "There is a culvert under that road. Culvert. Get somebody who listens.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 7,
      "text": "Enemy mortar just moved. I say moved, they will shoot the old spot first.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    }
  ]
}
