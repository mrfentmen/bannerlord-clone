  "lines": [
    {
      "index": 0,
      "text": "The rain came late and the wheat came short. We adjust, we do not panic.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "Chicago eats because Iowa works. Do not forget which way the truck drives.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "I will feed your people too, but you will remember who planted it.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "A promise in spring is a debt in fall. I collect debts.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "The soil teaches patience. I teach the rest.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
