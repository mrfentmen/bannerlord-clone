  "lines": [
    {
      "index": 0,
      "text": "The ranch is mine, the roads are mine, the price is what I say.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "I do not shake on maybes. I shake on numbers.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "You want my trucks? They leave at dawn with or without you.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "Texas taught me one lesson: feed the strong and the rest sorts itself.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "Talk fast or pay slow. Your choice, and I do not care which.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
