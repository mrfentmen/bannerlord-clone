  "lines": [
    {
      "index": 0,
      "text": "Sit down. The coffee is terrible and the company is worse, but sit.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "I have buried men who rushed. I will not rush you and you will not rush me.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "A handshake from me is worth more than a contract from most. Remember that.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "Denver remembers who showed up in the hard winter. So do I.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "Say it plain and say it once. I will do the rest.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
