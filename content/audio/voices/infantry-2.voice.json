  "lines": [
    {
      "index": 0,
      "text": "Rifles on the left, rifles on the right, me in the middle.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 1,
      "text": "I see them. Two hundred meters and coming.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 2,
      "text": "Moving up on the ridge, keep your heads down till I say.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 3,
      "text": "Nobody move until the captain says move. That is the whole order.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 4,
      "text": "Magazine out. I am out. Somebody got me a rifle.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 5,
      "text": "Smoke on the left, that is not ours.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 6,
      "text": "Do not fire until you hear the word. I will say the word.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 7,
      "text": "They are stacking on that fence line. Tell the gunners.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    }
  ]
