  "lines": [
    {
      "index": 0,
      "text": "Friend, you have got thirty seconds of my charm left. Use them well.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "Atlanta is open for business and business is me.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "I do not lose partners. I collect them, and I keep them fed.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "You want in? Step closer. You want out? Step faster.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "This town, this road, this whole corridor. All of it is negotiable.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
