  "lines": [
    {
      "index": 0,
      "text": "New face, new rules. You pay first, you drink second.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    },
    {
      "index": 1,
      "text": "Sit at the far end. The stool by the door is for men who want to leave fast.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    },
    {
      "index": 2,
      "text": "I have heard every story. Yours better have a shorter ending.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    },
    {
      "index": 3,
      "text": "The soup is yesterday's. The beer is today's. Choose wisely.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    },
    {
      "index": 4,
      "text": "Last call is when I say so, and I say so early.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    },
    {
      "index": 5,
      "text": "You want gossip, buy two rounds. One round buys you silence.",
      "emotion": "warm",
      "context_tags": [
        "tavern",
        "greeting"
      ]
    }
  ]
}
