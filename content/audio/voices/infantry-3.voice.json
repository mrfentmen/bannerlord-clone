  "loudness_lufs": -24.1,
  "lines": [
    {
      "index": 0,
      "text": "The truck is stuck. Do not get yourself killed going around it.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 1,
      "text": "Third man back is down. Watch your spacing.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 2,
      "text": "They just found the road. They know where the road is.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 3,
      "text": "Somebody get that man out of the way, he is in the lane.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 4,
      "text": "They have trucks coming up behind them. More than I want to see.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 5,
      "text": "Flats are open, use the ditches. Ditches, not the road.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 6,
      "text": "Fix your helmet. Fix it now, we do not have time to argue.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 7,
      "text": "Watch the muzzle, that flash is theirs, we are down and we are staying down.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    },
    {
      "index": 8,
      "text": "I am out of magazines and I am not moving until somebody says I can.",
      "emotion": "urgent",
      "context_tags": [
        "combat",
        "contact"
      ]
    }
  ]
}
