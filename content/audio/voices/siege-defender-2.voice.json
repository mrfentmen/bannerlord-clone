  "lines": [
    {
      "index": 0,
      "text": "They are at the south wall. South wall, everybody who can walk.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 1,
      "text": "Keep the doors barred and the windows lit. Make them think twice.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 2,
      "text": "Do not leave the well. If we lose the well we lose the week.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 3,
      "text": "Wounded go to the cellar, not the street. The cellar, I said.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 4,
      "text": "Hold the landing, not the stairs. Let the stairs eat them.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 5,
      "text": "If the wall falls, the school is the wall. Everybody knows the plan.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 6,
      "text": "Stay off the parapet and keep your rifles loaded. They are not done.",
      "emotion": "determined",
      "context_tags": [
        "combat"
      ]
    }
  ]
}
