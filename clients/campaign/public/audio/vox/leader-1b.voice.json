  "lines": [
    {
      "index": 0,
      "text": "The ports are open and the trucks are rolling. That is the headline, learn it.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "You want my time? Bring me numbers I have not already seen.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "Los Angeles did not survive the fall by hoping. It survived by counting.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "Every promise in this room costs diesel. Count it or drop it.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "I am Marisol Vega. If you lie to me, lie with a spreadsheet. I respect effort.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
