  "lines": [
    {
      "index": 0,
      "text": "Kneel. You know the sentence. We all heard it read.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    },
    {
      "index": 1,
      "text": "Any last words, say them to the sky. Nobody here is writing them down.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    },
    {
      "index": 2,
      "text": "This is not anger. Anger would be quicker. This is the law, and the law is slow.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    },
    {
      "index": 3,
      "text": "You had your trial. You had your say. This is the part after.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    },
    {
      "index": 4,
      "text": "Look at me when it happens. It is the least you owe the people watching.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    },
    {
      "index": 5,
      "text": "May whoever is keeping score be kinder to you than you were to them.",
      "emotion": "solemn",
      "context_tags": [
        "threat"
      ]
    }
  ]
}
