  "lines": [
    {
      "index": 0,
      "text": "Friend, you look like a man with a problem I can solve before lunch.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "Atlanta runs on handshakes and I have got two hands, so let us get to it.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "I like you. That is forty percent of my decision and the other sixty is the numbers.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "Nobody ever got rich standing still. Move with me and we both eat.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "You bring the men, I bring the market, and we split the future down the middle.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
