  "lines": [
    {
      "index": 0,
      "text": "The baker's boy ran off with the church donations. Pray for him, I guess.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 1,
      "text": "My sister's kettle whistles the battle hymn now. Nobody knows why.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 2,
      "text": "If the well runs dry again, I am moving to the river, invite and all.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 3,
      "text": "The price of beans went up. Again. Beans, people.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 4,
      "text": "I saw the captain smile today. Write it in the town record.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    }
  ]
