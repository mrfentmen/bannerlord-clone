  "lines": [
    {
      "index": 0,
      "text": "They took the bridge toll money and built a wall around it.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 1,
      "text": "I am done asking. Asking was the old me.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 2,
      "text": "You want freedom, it is priced in work. Start paying.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 3,
      "text": "They call us a mob when we show up together. Fine. Mob up.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 4,
      "text": "Nobody voted for the fence. Nobody voted for the curfew either.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 5,
      "text": "Bring the neighbors. The brave ones, the quiet ones, all of them.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    },
    {
      "index": 6,
      "text": "We take the mill back at dawn. Sleep now or march hungry.",
      "emotion": "angry",
      "context_tags": [
        "threat",
        "idle"
      ]
    }
  ]
}
