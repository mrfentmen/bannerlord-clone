  "sample_rate_hz": 48000,
  "duration_s": 35.83,
  "loudness_lufs": -25.3,
  "lines": [
    {
      "index": 0,
      "text": "Flour is up again. Everything made of wheat is up again. Welcome to the circle.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 1,
      "text": "Tires. Nobody has tires. That is the whole market report this quarter.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 2,
      "text": "If you need a part, ask me for the part you can afford and then I will tell you what breaks first.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 3,
      "text": "That is the price on the tag and the tag is not a suggestion.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 4,
      "text": "Cash gets you the sale price. Card gets you the regular price and the receipt.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 5,
      "text": "Last one at that price. When it is gone I will not get another one for weeks.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 6,
      "text": "Come back before the list runs out. It will run out.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    },
    {
      "index": 7,
      "text": "Drive careful. That road wants one truck at a time and no heroics.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "bargain"
      ]
    }
  ]
}
