  "lines": [
    {
      "index": 0,
      "text": "I am going to say this once, and I am going to say it slow, so listen.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 1,
      "text": "A man who finishes a sentence is a man I can work with. Be that man.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 2,
      "text": "Denver did not get built by people in a hurry. It got built by people who stayed.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 3,
      "text": "You give me your word, you keep it. That is the whole contract.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    },
    {
      "index": 4,
      "text": "I do not rush. Rushing is how you lose men and mountains both.",
      "emotion": "stern",
      "context_tags": [
        "quest_offer"
      ]
    }
  ]
}
