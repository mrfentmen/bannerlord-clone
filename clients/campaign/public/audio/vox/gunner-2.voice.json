  "lines": [
    {
      "index": 0,
      "text": "Heat is climbing, I have got maybe another minute.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 1,
      "text": "Their muzzle just lit up. Thirty seconds out, get down.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 2,
      "text": "I have him in the reticle. I need everybody quiet for three seconds.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 3,
      "text": "They dug in. I can hit that dirt. I cannot hit a man in it.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 4,
      "text": "Shifting left thirty, shifting, watch your own feet.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 5,
      "text": "That was our last belt for this position, do with it what you want.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 6,
      "text": "First one walked into my lane. First one. That is going in the report.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    },
    {
      "index": 7,
      "text": "Ammunition is at the truck. Get somebody to go get ammunition.",
      "emotion": "angry",
      "context_tags": [
        "combat"
      ]
    }
