  "lines": [
    {
      "index": 0,
      "text": "The convoy woke my dog at four. The dog is still mad. So am I.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 1,
      "text": "Somebody's generator is running all night again. That is the sound of money.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 2,
      "text": "They paved half the road and left. Classic.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 3,
      "text": "My cousin joined a faction. My aunt joined a different one. Dinner is tense.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 4,
      "text": "Rain is coming. You can smell it before the radio says it.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    },
    {
      "index": 5,
      "text": "The price of nails went up again. Nails. Somebody explain nails to me.",
      "emotion": "warm",
      "context_tags": [
        "town",
        "greeting"
      ]
    }
  ]
