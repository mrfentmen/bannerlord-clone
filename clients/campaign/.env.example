# Which simulation source the client reads from.
#
#   http     - Agent 2's API (Contract B). The production setting.
#   fixture  - Clearly-labelled test fixtures, for development and tests only.
#              tools/check-no-fixtures.mjs fails any production build that sets this.
#
# See clients/campaign/src/data/provider.ts.
VITE_SIMULATION_SOURCE=http
VITE_SIMULATION_HTTP_URL=http://127.0.0.1:8080
VITE_SIMULATION_WS_URL=ws://127.0.0.1:8080/ws

# Where the world data lives. Defaults to /world/ under the app root, which is
# where tools/fetch-world-data.mjs writes it. Agent 1's portable export can be
# pointed at here once it lands.
VITE_WORLD_DATA_URL=/world

# Camera and grade quality. Low disables grain, vignette and FXAA
# (ART_AND_AUDIO.md section 10 requires post-processing to be optional).
VITE_QUALITY=high
