# npm 10.9.8's peer resolver crashes on vitest 4's optional peer graph
# (@vitest/browser-playwright) with "Cannot read properties of null (reading
# 'edgesOut')". --legacy-peer-deps bypasses it. Recorded in clients/campaign/CHANGELOG.md.
#
# Do not remove without checking `npm install` still resolves cleanly on this npm
# version. Upgrading npm is not an option: agents/README.md rule 7 forbids global
# installs.
legacy-peer-deps=true
audit=true
fund=false
